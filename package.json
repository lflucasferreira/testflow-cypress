{
  "name": "testflow-cypress",
  "version": "1.0.0",
  "private": true,
  "description": "Cypress E2E automation for TestFlow web app",
  "scripts": {
    "slides": "npx serve . -p 3333",
    "slides:open": "npx serve . -p 3333 & sleep 1 && open http://localhost:3333/docs/slides/",
    "slides:pdf": "node scripts/export-slides-pdf.mjs",
    "cy:open": "cypress open",
    "cy:open:component": "cypress open --component",
    "cy:run": "cypress run",
    "cy:run:headed": "cypress run --headed",
    "cy:run:smoke": "cypress run --env grepTags=@smoke",
    "cy:run:regression": "cypress run --env grepTags=@regression",
    "cy:run:critical": "cypress run --env grepTags=@critical",
    "cy:run:api": "cypress run --spec 'cypress/e2e/api/**'",
    "cy:run:auth": "cypress run --spec 'cypress/e2e/auth/**'",
    "cy:run:dashboard": "cypress run --spec 'cypress/e2e/dashboard/**'",
    "cy:run:team": "cypress run --spec 'cypress/e2e/team/**'",
    "cy:run:settings": "cypress run --spec 'cypress/e2e/settings/**'",
    "cy:run:components": "cypress run --spec 'cypress/e2e/components/**'",
    "cy:run:wizard": "cypress run --spec 'cypress/e2e/wizard/**'",
    "cy:run:advanced": "cypress run --spec 'cypress/e2e/advanced/**'",
    "cy:run:activity": "cypress run --spec 'cypress/e2e/activity/**'",
    "cy:run:states": "cypress run --spec 'cypress/e2e/states/**'",
    "cy:run:a11y": "cypress run --env grepTags=@a11y",
    "cy:run:component": "cypress run --component",
    "cy:run:component:ct": "cypress run --component --spec 'cypress/component/**'"
  },
  "devDependencies": {
    "@bahmutov/cy-grep": "^2.1.0",
    "@cypress/react18": "^2.0.1",
    "@faker-js/faker": "^9.8.0",
    "@vitejs/plugin-react": "^4.4.1",
    "cypress": "^13.17.0",
    "cypress-axe": "^1.5.0",
    "cypress-mochawesome-reporter": "^3.8.4",
    "cypress-plugin-steps": "^1.2.1",
    "decktape": "^3.16.1",
    "highlight.js": "^11.11.1",
    "mochawesome-merge": "^4.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reveal.js": "^5.1.0",
    "vite": "^5.4.19"
  }
}
