{
  "name": "testflow-cypress",
  "version": "1.0.0",
  "private": true,
  "description": "Cypress E2E automation for TestFlow web app",
  "scripts": {
    "slides": "npx serve . -p 3333",
    "slides:open": "npx serve . -p 3333 & sleep 1 && open http://localhost:3333/docs/slides/",
    "slides:guia": "npx serve . -p 3333 & sleep 1 && open http://localhost:3333/docs/slides/guia-completo.html",
    "slides:guide": "npx serve . -p 3333 & sleep 1 && open http://localhost:3333/docs/slides/complete-guide.html",
    "slides:pdf": "node scripts/export-slides-pdf.mjs",
    "cy:open": "cypress open",
    "cy:open:component": "cypress open --component",
    "cy:run": "bash scripts/cy-run.sh",
    "cy:run:headed": "bash scripts/cy-run.sh --headed",
    "cy:run:smoke": "bash scripts/cy-run.sh --env grepTags=@smoke",
    "cy:run:regression": "bash scripts/cy-run.sh --env grepTags=@regression",
    "cy:run:critical": "bash scripts/cy-run.sh --env grepTags=@critical",
    "cy:run:api": "bash scripts/cy-run.sh --spec 'cypress/e2e/api/**'",
    "cy:run:auth": "bash scripts/cy-run.sh --spec 'cypress/e2e/auth/**'",
    "cy:run:dashboard": "bash scripts/cy-run.sh --spec 'cypress/e2e/dashboard/**'",
    "cy:run:team": "bash scripts/cy-run.sh --spec 'cypress/e2e/team/**'",
    "cy:run:settings": "bash scripts/cy-run.sh --spec 'cypress/e2e/settings/**'",
    "cy:run:components": "bash scripts/cy-run.sh --spec 'cypress/e2e/components/**'",
    "cy:run:wizard": "bash scripts/cy-run.sh --spec 'cypress/e2e/wizard/**'",
    "cy:run:advanced": "bash scripts/cy-run.sh --spec 'cypress/e2e/advanced/**'",
    "cy:run:activity": "bash scripts/cy-run.sh --spec 'cypress/e2e/activity/**'",
    "cy:run:states": "bash scripts/cy-run.sh --spec 'cypress/e2e/states/**'",
    "cy:run:a11y": "bash scripts/cy-run.sh --env grepTags=@a11y",
    "cy:run:visual": "bash scripts/cy-run.sh --spec 'cypress/e2e/visual/**'",
    "cy:run:visual:percy": "percy exec -- bash scripts/cy-run.sh --spec 'cypress/e2e/visual/**'",
    "cy:run:component": "bash scripts/cy-run.sh --component",
    "cy:run:component:ct": "bash scripts/cy-run.sh --component --spec 'cypress/component/**'",
    "cy:report:merge": "mochawesome-merge 'cypress/reports/.jsons/*.json' -o cypress/reports/merged.json && marge cypress/reports/merged.json --reportDir cypress/reports/html --reportTitle 'TestFlow — Cypress Report' --inline",
    "cy:report:open": "open cypress/reports/html/*.html 2>/dev/null || open cypress/reports/html/index.html",
    "cy:run:smoke:report": "npm run cy:run:smoke && npm run cy:report:open",
    "cy:run:cloud": "CYPRESS_PARALLEL=true bash scripts/cy-run.sh",
    "cy:run:smoke:cloud": "bash scripts/cy-run.sh --env grepTags=@smoke"
  },
  "devDependencies": {
    "@bahmutov/cy-grep": "^3.0.4",
    "@cypress/react18": "^2.0.1",
    "@faker-js/faker": "^9.8.0",
    "@percy/cli": "^1.31.14",
    "@percy/cypress": "^3.1.8",
    "@vitejs/plugin-react": "^4.4.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "cypress": "^15.17.0",
    "cypress-axe": "^1.5.0",
    "cypress-mochawesome-reporter": "^3.8.4",
    "cypress-plugin-steps": "^1.2.1",
    "decktape": "^3.16.1",
    "highlight.js": "^11.11.1",
    "mochawesome-merge": "^4.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reveal.js": "^5.1.0",
    "vite": "^5.4.19"
  }
}
